# Optional path to local YOLO weights fine-tuned for leak/corrosion classes.
HYDROVISION_MODEL_PATH=/absolute/path/to/best.pt
# Optional fixed API URL. Leave blank to use the portal host on port 8001,
# which supports access from other computers on the same Wi-Fi.
NEXT_PUBLIC_API_URL=
# Comma-separated extra frontend origins permitted to call the local API.
HYDROVISION_ALLOWED_ORIGINS=
