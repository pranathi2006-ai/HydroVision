# Optional path to local YOLO weights fine-tuned for leak/corrosion classes.
HYDROVISION_MODEL_PATH=/absolute/path/to/best.pt
# Optional fixed API URL. Leave blank to use the portal host on port 8001,
# which supports access from other computers on the same Wi-Fi.
NEXT_PUBLIC_API_URL=
# Comma-separated extra frontend origins permitted to call the local API.
HYDROVISION_ALLOWED_ORIGINS=

# Phase 1 operational readings. Change only this value to swap adapters.
HYDROVISION_PERFORMANCE_SOURCE=mock
# Polling never runs faster than either of these intervals (default: 5 min).
HYDROVISION_PERFORMANCE_POLL_SECONDS=300
HYDROVISION_SOURCE_UPDATE_SECONDS=300

# Phase 2 design-reference calculation configuration.
HYDROVISION_UNIT_ID=turbine_1
HYDROVISION_NAMEPLATE_CAPACITY_MW=75

# RealSourceAdapter connection stub. Confirm these with the plant controls team.
HYDROVISION_PLANT_API_URL=
HYDROVISION_PLANT_API_TOKEN=
HYDROVISION_PLANT_API_TIMEOUT_SECONDS=15
HYDROVISION_PLANT_FIELD_TS=timestamp
HYDROVISION_PLANT_FIELD_HEADWATER=headwater_level
HYDROVISION_PLANT_FIELD_TAILWATER=tailwater_level
HYDROVISION_PLANT_FIELD_GATE=gate_position
HYDROVISION_PLANT_FIELD_ACTUAL_MW=generation_mw

# Site-specific physical validation limits. Defaults are deliberately broad.
HYDROVISION_HEADWATER_MIN=0
HYDROVISION_HEADWATER_MAX=500
HYDROVISION_TAILWATER_MIN=0
HYDROVISION_TAILWATER_MAX=500
HYDROVISION_GATE_POSITION_MIN=0
HYDROVISION_GATE_POSITION_MAX=100
HYDROVISION_ACTUAL_MW_MIN=0
HYDROVISION_ACTUAL_MW_MAX=1000

# Keep the verification UI on the same minutes-scale cadence as ingestion.
NEXT_PUBLIC_PERFORMANCE_POLL_SECONDS=300

# Phase 3 detector thresholds and optional local task-specific weights.
HYDROVISION_TRASH_BLOCKAGE_THRESHOLD_PCT=8
HYDROVISION_DRAFT_BLOCKAGE_THRESHOLD_PCT=8
HYDROVISION_CAVITATION_WEAR_THRESHOLD_PCT=0.8
HYDROVISION_GATE_MISMATCH_THRESHOLD_PCT=8
HYDROVISION_GATE_OPEN_EDGE_RATIO=0.20
HYDROVISION_GATE_CLOSED_EDGE_RATIO=0.80
HYDROVISION_THERMAL_DELTA_THRESHOLD_C=12
HYDROVISION_THERMAL_PERSISTENCE_FRAMES=3
HYDROVISION_THERMAL_SCALE_MIN_C=20
HYDROVISION_THERMAL_SCALE_MAX_C=100
HYDROVISION_TRASH_RACK_MODEL_PATH=
HYDROVISION_CAVITATION_MODEL_PATH=
HYDROVISION_DRAFT_TUBE_BLOCKAGE_MODEL_PATH=

# Phase 4 rule attribution. Confirm this boundary with the controls team.
# Attribution is disabled for real sources until generator_terminal is explicit.
HYDROVISION_ACTUAL_MW_METER_LOCATION=generator_terminal
HYDROVISION_ATTRIBUTION_GAP_THRESHOLD_PCT=5
HYDROVISION_ATTRIBUTION_EVIDENCE_WINDOW_SECONDS=21600
